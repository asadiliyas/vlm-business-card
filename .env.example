# Copy to .env at the repo root before running `docker compose up`.
# This file is read by BOTH docker-compose.yml (for APP_DOMAIN, used by
# Caddy) and passed through to the app container (same variables the
# backend reads directly — see backend/.env.example for what each one does
# when running the backend outside Docker).

# --- Public hostname Caddy requests a TLS cert for ---
# sslip.io gives you free, real DNS for any IP with zero setup: replace the
# dashed IP below with your app EC2 instance's actual Elastic IP.
#   1.2.3.4  ->  vlm-cards.1-2-3-4.sslip.io
APP_DOMAIN=vlm-cards.CHANGE-ME.sslip.io

ENVIRONMENT=production
DATA_DIR=./data
RETENTION_MINUTES=60

VLM_PRIMARY_BASE_URL=http://CHANGE-ME-GPU-INSTANCE-IP:8000/v1
VLM_PRIMARY_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
VLM_PRIMARY_API_KEY=not-needed
VLM_PRIMARY_ENABLED=true

VLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_FALLBACK_MODEL=qwen-vl-max
VLM_FALLBACK_API_KEY=sk-REPLACE-ME
VLM_FALLBACK_ENABLED=true

VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=2
VLM_TEMPERATURE=0.0
VLM_CONFIDENCE_RETRY_THRESHOLD=0.55

MAX_FILES_PER_JOB=40
MAX_FILE_MB=10
PROCESSING_CONCURRENCY=4
IMAGE_LONG_EDGE_PX=1280
THUMBNAIL_PX=256

RATE_LIMIT_PER_MINUTE=20
