# Copy this file to .env and fill in real values. Never commit .env.
#
# See docs/ARCHITECTURE.md for the primary/fallback VLM backend design.

ENVIRONMENT=development
DATA_DIR=./data
RETENTION_MINUTES=60

# --- Primary backend: self-hosted Qwen2.5-VL (vLLM on EC2 GPU, or llama.cpp
# on EC2 CPU as the contingency). Point this at whatever is currently
# deployed; leave the host defaults for local development against a locally
# running vLLM/llama.cpp instance. ---
VLM_PRIMARY_BASE_URL=http://localhost:8001/v1
VLM_PRIMARY_MODEL=Qwen2.5-VL-7B-Instruct-AWQ
VLM_PRIMARY_API_KEY=not-needed
VLM_PRIMARY_ENABLED=true

# --- Fallback backend: hosted Qwen. Used automatically whenever the
# primary is unreachable, times out, or errors — see docs/ARCHITECTURE.md
# §2 for the full picture, including a known current limitation: OpenRouter
# throttles vision requests hard for accounts with no payment history, so
# this fallback is best-effort rather than guaranteed-reliable until that
# account has some usage history (or DashScope becomes available in your
# country — swap the base URL/model/key below if so, e.g.
# https://dashscope.aliyuncs.com/compatible-mode/v1 with model qwen-vl-max). ---
VLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
VLM_FALLBACK_MODEL=qwen/qwen3.8-27b:free
VLM_FALLBACK_API_KEY=sk-or-REPLACE-ME
VLM_FALLBACK_ENABLED=true

VLM_TIMEOUT_SECONDS=240
VLM_MAX_RETRIES=2
VLM_TEMPERATURE=0.0
VLM_CONFIDENCE_RETRY_THRESHOLD=0.55

MAX_FILES_PER_JOB=40
MAX_FILE_MB=10
PROCESSING_CONCURRENCY=2
IMAGE_LONG_EDGE_PX=1280
THUMBNAIL_PX=256

RATE_LIMIT_PER_MINUTE=20

# Only used in local dev when the Vite dev server (5173) calls this API
# directly. Not needed in production — the frontend is served from the same
# origin as the API there.
CORS_ORIGINS=["http://localhost:5173"]
